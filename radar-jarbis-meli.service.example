[Unit]
Description=RadarJarbis - Mercado Livre Telegram Bot Service
After=network.target

[Service]
Type=simple
User=SEU_USUARIO_LINUX
Group=SEU_GRUPO_LINUX
WorkingDirectory=/caminho/para/radar-jarbis
ExecStart=/caminho/para/radar-jarbis/.venv/bin/python -m src.bot_meli
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=radar-jarbis-meli

# Segurança e isolamento
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
