# ============================================================
# RadarJarbis — Template de Variáveis de Ambiente
# ============================================================
# Copie este arquivo para config/.env e preencha com seus dados:
#   cp config/.env.example config/.env
#
# NUNCA versione o arquivo config/.env
# ============================================================

# ------------------------------------------------------------
# Conta Comum — MTProto (Telethon)
# Obtenha em: https://my.telegram.org > API development tools
# ------------------------------------------------------------
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890abcdef12

# ------------------------------------------------------------
# Bot Token — Postagem no canal de saída
# Obtenha em: @BotFather no Telegram > /newbot
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# Canais de Fluxo
# SOURCE_CHANNEL_IDS: IDs numéricos dos canais master (separados por vírgula)
# Formato: -100 + o ID do canal (ex: -1001234567890)
# OUTPUT_CHANNEL_ID: username ou ID do canal de saída
# ------------------------------------------------------------
SOURCE_CHANNEL_IDS=-100000000000, -10000000001
OUTPUT_CHANNEL_ID=@seucanal

# ------------------------------------------------------------
# Rate Limit — Delay entre postagens (segundos)
# Mínimo recomendado: 3.0 (evitar banimento por SPAM)
# ------------------------------------------------------------
RATE_LIMIT_DELAY=3.5

# ------------------------------------------------------------
# Deduplicação por ASIN (mesmo produto de afiliado diferente)
# Define por quantas horas o mesmo produto (ASIN) não deve ser repetido.
# Padrão: 24 horas.
# ------------------------------------------------------------
DEDUPLICATION_WINDOW_HOURS=24

# ------------------------------------------------------------
# Publicação de Cupons Gerais
# Habilita/desabilita a postagem de cupons gerais da Amazon.
# Padrão: false (desabilitado)
# ------------------------------------------------------------
ENABLE_COUPONS=false

# ------------------------------------------------------------
# Modo Prime Day
# Habilita/desabilita o modo de ofertas Prime Day (gatilho fixo "🔥 OFERTA PRIME DAY 🔥").
# Padrão: false (desabilitado)
# ------------------------------------------------------------
PRIME_DAY_MODE=false

# ------------------------------------------------------------
# Mercado Livre Afiliados
# ------------------------------------------------------------
MELI_USER_ID=
MELI_AFFILIATE_TAG=noradardojarbis
MELI_COOKIES=

# ------------------------------------------------------------
# Métricas Prometheus (Zabbix / Grafana)
# ------------------------------------------------------------
METRICS_PORT=8000
METRICS_PORT_MELI=8001

# ------------------------------------------------------------
# Supabase PostgreSQL
# A integração permanece desabilitada quando as flags estão vazias.
# Preencha manualmente; nunca versione credenciais reais.
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ENABLED=
SUPABASE_REQUIRED=
